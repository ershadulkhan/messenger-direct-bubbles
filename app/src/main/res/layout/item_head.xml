<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="60dp"
    android:layout_height="60dp"
    android:layout_marginEnd="2dp"
    android:background="?android:attr/selectableItemBackgroundBorderless">

    <View
        android:id="@+id/head_ring"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_head_selected"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/head_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:contentDescription="Chat"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/head_badge"
        android:layout_width="19dp"
        android:layout_height="19dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="1dp"
        android:background="@drawable/bg_badge_ring_white"
        android:contentDescription="App"
        android:padding="1.5dp" />

    <TextView
        android:id="@+id/head_dot"
        android:layout_width="wrap_content"
        android:layout_height="19dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:background="@drawable/bg_unread_dot"
        android:gravity="center"
        android:minWidth="19dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="#FFFFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
