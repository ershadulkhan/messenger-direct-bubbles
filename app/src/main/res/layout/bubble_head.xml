<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="76dp"
    android:layout_height="76dp">

    <ImageView
        android:id="@+id/bubble_avatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_avatar"
        android:contentDescription="Chat head"
        android:elevation="6dp"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/bubble_badge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_badge_ring"
        android:contentDescription="App"
        android:elevation="7dp"
        android:padding="2dp" />

    <TextView
        android:id="@+id/bubble_unread"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="3dp"
        android:background="@drawable/bg_unread_badge"
        android:elevation="8dp"
        android:gravity="center"
        android:minWidth="22dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
